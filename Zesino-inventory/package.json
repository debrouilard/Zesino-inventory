{
  "name": "zesino-inventory",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "test": "npm run test --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:seed": "npm run db:seed --prefix server"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
